<!-- ================= ARROW SOUND SCRIPT ================= -->

<script>

const roadmapButton = document.getElementById("roadmapButton");
const arrowSound = document.getElementById("arrowSound");

roadmapButton.addEventListener("click", function () {

    /*
       The <a> will automatically navigate to /roadmap.
       We only play the sound here.
    */

    if (arrowSound) {

        arrowSound.currentTime = 0;

        arrowSound.play().catch(function () {
            // Navigation still works if browser blocks audio.
        });

    }

});

</script>

